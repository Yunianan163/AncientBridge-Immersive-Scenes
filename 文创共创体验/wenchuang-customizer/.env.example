# 复制本文件为 .env，填入自己的密钥后即可使用 AI 生图
# cp .env.example .env

# 【必填】火山方舟（Volcengine Ark）API Key
# 获取：https://console.volcengine.com/ark → 左侧「API Key 管理」
ARK_API_KEY=填你的key

# 【可选】以下都有默认值，一般不用改
#
# 生图模型 ID。⚠️ 必须用**带版本号的完整 ID**：
#   不带后缀的 `doubao-seedream-5-0` 是滚动别名，指向已退役的 260128 版本，
#   直调会报 `OperationDenied.ModelRetiring`；在售版本形如 doubao-seedream-5-0-flash-260915，
#   以控制台「模型开通」页的列表为准。
# ARK_MODEL=doubao-seedream-5-0-flash-260915
#
# 出图尺寸：文案档 `2K` / `4K`，或具体像素如 `2048x2048`
# ARK_SIZE=2K
#
# 是否给生成图打「AI 生成」水印。默认 true；填 false 关掉
# ARK_WATERMARK=true
#
# 输出侧内容 / 版权审核被拦时自动重试几次，默认 1。
# 这一侧的判定带随机性（同一份输入换个时刻往往就过了），所以默认补一次；
# 但每次重试都真实计费，想完全手动控制就填 0。
# ARK_POLICY_RETRY=1
#
# 上游接口地址（方舟国内站，一般不用改）
# ARK_ENDPOINT=https://ark.cn-beijing.volces.com/api/v3/images/generations
#
# 后端端口
# PORT=3001

# ---------------------------------------------------------------------------
# 【可选】前端（vite）变量。注意：前端变量必须带 VITE_ 前缀才会被注入浏览器。
# 三个都有代码内默认值，不配也能跑；下面列出以便换机器/换端口时知道改哪里。
# ---------------------------------------------------------------------------
# vite 代理的后端目标（server.proxy 与 preview.proxy 共用）。默认 http://localhost:3001
# VITE_API_TARGET=http://localhost:3001
# 前端请求后端的基地址。留空＝走同源相对路径（即交给上面的 vite 代理），一般不用改
# VITE_API_BASE=
# 部署到子路径时用（例如 /bridge/）。默认 /
# VITE_BASE_PATH=/
