{
  "name": "wenchuang-customizer",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "文创商品 AI 定制：文字生图 → 点击选面贴到 3D 商品 → 旋转预览 → 导出下单",
  "scripts": {
    "dev": "vite",
    "dev:all": "node scripts/dev-all.mjs",
    "server": "node server/index.js",
    "models:placeholder": "node scripts/make-placeholder-models.mjs",
    "models:verify": "node scripts/verify-models.mjs",
    "models:fix": "node scripts/fix-model.mjs",
    "models:regions": "node scripts/emit-regions.mjs",
    "models:section": "node scripts/probe-section.mjs",
    "models:layers": "node scripts/probe-layers.mjs",
    "texture:pattern": "node scripts/make-pattern-texture.mjs",
    "check:material": "node scripts/check-material.mjs",
    "check:export": "node scripts/check-export.mjs",
    "e2e:paint": "node scripts/e2e-paint.mjs",
    "e2e:finish": "node scripts/e2e-finish.mjs",
    "models:regress": "node scripts/run-regression.mjs",
    "models:matrix": "node scripts/make-matrix.mjs",
    "shot": "node scripts/e2e-shot.mjs",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "preview": "vite preview",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@react-three/drei": "^10.1.2",
    "@react-three/fiber": "^9.1.2",
    "@types/three": "^0.177.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "three": "^0.177.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.0",
    "@types/node": "^22.15.30",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "eslint": "^9.25.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^16.0.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.30.1",
    "vite": "^6.3.5"
  }
}
