# =============================================================================
# 贵州葛镜桥 · 实时语音对话（豆包 Seeduplex 3.0）凭据模板
# -----------------------------------------------------------------------------
# 用法：把本文件复制成 `.env`（同目录），填入真实值。
#      `.env` 已被 .gitignore 忽略，不会进交付包 / 版本库。
#
# 也可以不改文件，直接用进程环境变量覆盖（环境变量优先级更高）：
#      set VOICE_API_KEY=xxx && node tools/voice-proxy.mjs
#
# ⚠️ 绝对不要把真实凭据写进 js/ 下的任何文件 —— 那些文件会被浏览器直接下载，
#    等于把密钥发给每一个访客。凭据只在这一层，由 tools/voice-proxy.mjs 读取。
# =============================================================================

# 【必填】新版控制台的 API Key（火山引擎控制台 → 语音技术 → API Key 管理）
# 对应上游请求头 X-Api-Key
VOICE_API_KEY=

# 以下均可选，留空则用代码里的默认值

# 上游端点（Seeduplex 3.0 用的就是这条 duplex 路径）
# VOICE_ENDPOINT=wss://openspeech.bytedance.com/api/v3/duplex/realtime/dialogue
# 模型版本，Seeduplex 3.0 固定 1.2.6.1
# VOICE_MODEL=1.2.6.1
# 音色 ID，可选项见 https://docs.volcengine.com/docs/6561/1257544
# VOICE_SPEAKER=zh_female_vv_jupiter_bigtts
# 语速 / 音量：取值 -50 ~ 100，0 为默认（放在 session.audio.output 里发给上游）
# VOICE_SPEED=0
# VOICE_LOUDNESS=0
# 是否允许模型主动搭话。官方 Demo 默认开；讲解场景默认关，免得没被问就自己说
# VOICE_PROACTIVE_SPEAK=false
# 输出音频格式：pcm_s16le（16 位小端，默认）/ pcm（32 位）/ ogg_opus
# ⚠️ 本项目的播放链路只实现了 PCM —— 改成 ogg_opus 会听不到声音（客户端会明确报出来）
# VOICE_OUTPUT_FORMAT=pcm_s16le
# 资源 ID。官方 Seeduplex Demo **不发送** X-Api-Resource-Id，所以默认留空；
# 只有旧账号确实需要显式指定资源时才填
# VOICE_RESOURCE_ID=
# 本机代理端口（前端 js/voice.js 里连的就是它）
# VOICE_PROXY_PORT=8124
# 系统提示词：决定这个语音讲解员的人设与说话风格
# VOICE_INSTRUCTIONS=你是贵州福泉葛镜桥的 AI 语音讲解员……

# -----------------------------------------------------------------------------
# 【兼容旧版控制台】如果你用的是旧版控制台的三件套，填这三个即可（VOICE_API_KEY 留空）
# -----------------------------------------------------------------------------
# VOICE_APP_ID=
# VOICE_ACCESS_TOKEN=
# VOICE_APP_KEY=
