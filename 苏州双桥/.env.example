# =============================================================================
# 苏州双桥 · 语音服务凭据（模板）
# -----------------------------------------------------------------------------
# 用法：把本文件复制成 `.env`（同目录），填入真实值。
#      `.env` 已被 .gitignore 忽略，不会进交付包 / 版本库。
#
# 也可以不改文件，直接用进程环境变量覆盖（环境变量优先级更高）：
#      set VOICE_ACCESS_TOKEN=xxx && node server.js
#
# ⚠️ 绝对不要把真实凭据写回 server.js 或 RealtimeDialog-Web/config.js ——
#    config.js 会被浏览器下载，写在那里等于把凭据公开。
# =============================================================================

# 火山引擎（豆包）实时语音 —— 控制台「语音技术 > 实时对话式 AI」里取
VOICE_APP_ID=
VOICE_ACCESS_TOKEN=
VOICE_APP_KEY=

# 以下均可选，留空则用代码里的默认值
# VOICE_RESOURCE_ID=volc.speech.dialog
# VOICE_MODEL=1.2.1.1
# VOICE_SPEAKER=S_tYw86oeY1
# VOICE_ENDPOINT=wss://openspeech.bytedance.com/api/v3/realtime/dialogue
